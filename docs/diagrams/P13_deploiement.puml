@startuml
' CONTROLE : 5 noeuds, 4 liens
title InvoiceFlow - déploiement
left to right direction
skinparam shadowing false

node "Navigateur de l'utilisateur" as N
node "Netlify (application React)" as NL
node "Render (API NestJS)" as R
